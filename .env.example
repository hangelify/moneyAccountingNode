# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=accounting

# Server Configuration
PORT=3000
NODE_ENV=development

# Reverse proxy trust (controls req.ip, used for rate limiting and session IPs)
# Unset/false: X-Forwarded-For is ignored (direct exposure, local dev).
# Number of hops: e.g. 1 for production behind a single reverse proxy.
# List of addresses/subnets: e.g. loopback, 10.0.0.0/8
# "true" is rejected: it lets any client spoof its IP via X-Forwarded-For.
TRUST_PROXY=

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# JWT Configuration
# Generate strong, random secrets: at least 32 bytes each, and different from
# each other, or the app refuses to start.
# You can generate secrets using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-in-production
# Access token expiration time in milliseconds (default: 15 minutes = 900000 ms)
JWT_EXPIRES_IN_MS=900000
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long-change-in-production
# Refresh token expiration time in milliseconds (default: 7 days = 604800000 ms)
JWT_REFRESH_EXPIRES_IN_MS=604800000
# iss and aud claims of issued tokens; tokens with other values are rejected.
# Changing either invalidates every issued token. Defaults: accounting-api
JWT_ISSUER=accounting-api
JWT_AUDIENCE=accounting-api
# Seconds after a rotation during which reusing the old refresh token gets 401
# without revoking the session (for clients retrying after a timeout).
# 0 (default) = any reuse revokes the whole session. Within the window a stolen
# token's reuse is not detected either, so keep it short (e.g. <= 30).
# An invalid value stops startup.
# REFRESH_REUSE_GRACE_SECONDS=0

# Per-account login lockout (optional; counters live in Redis). After
# LOGIN_MAX_FAILURES failed logins for one email within the window, logins for
# it get 429 with Retry-After, from any IP. Each further failure doubles the
# lock, up to the max. A successful login resets the count.
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=60
# LOGIN_LOCKOUT_MAX_SECONDS=900

# Logging Configuration (optional)
LOG_LEVEL=debug

# AI Gateway — provider keys (an adapter is disabled if its key is missing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Fail startup when an AI task (e.g. receipt photo parsing, needs vision) has no
# configured provider. Default: true when NODE_ENV=production, false otherwise.
# With false the app boots and the AI endpoints answer 503.
AI_REQUIRED=

# AI Gateway — call limits (optional, with defaults; invalid values fail startup)
AI_CALL_TIMEOUT_MS=60000
AI_TRANSIENT_RETRY_ATTEMPTS=2
AI_TRANSIENT_RETRY_BACKOFF_MS=500
AI_TASK_DEADLINE_MS=90000

# AI Gateway — usage limits (optional, with defaults; invalid values fail startup)
# Per-user AI requests per minute / per 24 hours (counted after authentication)
AI_USER_LIMIT_PER_MINUTE=10
AI_USER_LIMIT_PER_DAY=100
# Per-user AI spend over the last 24 hours, in USD, before calls get 429
AI_DAILY_BUDGET_USD=1
# AI calls running at once in ONE API instance (each instance counts separately); beyond it → 503
AI_MAX_CONCURRENCY=4

# Object storage (S3 or S3-compatible)
S3_REGION=us-east-1
S3_BUCKET=money-accounting-ai
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Redis Configuration (used for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Days an unconfirmed AI draft bill is kept before the daily cleanup (03:00 UTC)
# soft-deletes it. Default: 30. An invalid value stops startup.
# DRAFT_RETENTION_DAYS=30

# Data retention, run daily at 04:00 UTC (see README "Data Retention").
# Whole days >= 1; an invalid value stops startup.
# Refresh tokens are deleted this long after they expire. Default: 7.
# REFRESH_TOKEN_RETENTION_DAYS=7
# Sessions are deleted this long after they expire, or after their last use
# once revoked. Default: 30.
# SESSION_RETENTION_DAYS=30
# AI prompts and answers (receipt OCR) are nulled this long after the
# request; its status, tokens and cost are kept. Default: 30.
# AI_AUDIT_RAW_RETENTION_DAYS=30

# Pending, unexpired invites a household may have at once; creating one more
# answers 409. Default: 20. An invalid value stops startup.
# HOUSEHOLD_MAX_ACTIVE_INVITES=20
